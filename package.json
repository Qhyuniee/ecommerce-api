{
  "name": "ecommerce-api",
  "version": "1.0.0",
  "description": "Monolithic Ecommerce RESTful API using Node.js, Express, Prisma and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:admin": "node prisma/create-admin.js",
    "test": "node --check server.js"
  },
  "keywords": [
    "ecommerce",
    "monolithic",
    "rest-api",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  }
}
